# Copy to .env and fill in real values. Never commit the real .env.
# Generate random secrets with: openssl rand -hex 32

# ── Networking / domains ─────────────────────────────────────────────────
# For a LAN-only box with no public DNS, point these at hostnames you add to
# each client machine's hosts file (or your internal DNS) -> this server's IP.
# For a customer-facing install with a real domain, use real subdomains and
# delete "auto_https off" from Caddyfile so Caddy gets public certs.
PRODUCTIX_DOMAIN=app.productix.local
PRODUCTIX_API_DOMAIN=api.productix.local
ERPNEXT_DOMAIN=erp.productix.local
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# ── Productix database (local container, replaces Supabase for on-prem) ──
PRODUCTIX_DB_NAME=productix
PRODUCTIX_DB_USER=productix
PRODUCTIX_DB_PASSWORD=CHANGE_ME_RANDOM

# ── Productix central licensing (keeps calling your hosted license server) ─
CENTRAL_LICENSE_SERVER_URL=https://license.techohub.net
# Must match the LICENSE_SIGNING_KEY configured in licensing-server/db_config.php
# on the license server. Do NOT use the old hardcoded default — rotate it.
LICENSE_SIGNING_KEY=CHANGE_ME_MATCH_LICENSE_SERVER
PRODUCTIX_ENFORCE_CLIENT_LICENSING=true

# ── Productix outbound email (optional, leave blank to disable) ───────────
EMAIL=
EMAIL_PASSWORD=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ── Productix AI providers (optional per-deployment) ───────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=

# ── Productix internal admin kill-switch (see internal_admin.py) ──────────
# Required — do not leave blank, the code falls back to an insecure default.
MASTER_KILL_TOKEN=CHANGE_ME_RANDOM
# Comma-separated IPs allowed to call /api/internal/*. Leave blank only for
# initial local testing; set a real value before exposing this box.
MASTER_KILL_ALLOWED_IP=

# ── ERPNext connector (Phase 4 — router not built yet, values wired ahead) ─
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_MS=8000
ERPNEXT_ALLOWED_DOCTYPES="Item,Warehouse,Stock Ledger Entry,Work Order"

# ── ERPNext ──────────────────────────────────────────────────────────────
ERPNEXT_VERSION=v16.32.3
ERPNEXT_ADMIN_PASSWORD=CHANGE_ME_RANDOM
ERPNEXT_DB_ROOT_PASSWORD=CHANGE_ME_RANDOM
ERPNEXT_GUNICORN_THREADS=4
ERPNEXT_GUNICORN_WORKERS=2

# Use "always" while iterating on images, "missing" once versions are pinned
# and you don't want every `up` to re-check the registry.
PULL_POLICY=missing
